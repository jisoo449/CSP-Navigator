# 이 파일을 복사해 csp_navigator/.env 로 저장하고 값을 채운다. (NF2003)
#   Windows : copy .env.example .env
# .env 는 형상관리·제출물에 넣지 않는다.
# 상위 폴더(04 AI Application Core Project)의 .env 도 먼저 읽으므로, GMS_KEY·WIKI_CONTACT가 거기 있으면 다시 쓰지 않아도 된다.

# ── 필수 ───────────────────────────────────────────────
# SSAFY GMS 키 (https://gms.ssafy.io/web/)
GMS_KEY=
# GMS 주소. 실습 0단계(step0_llm.py)가 쓰는 OpenAI 호환 주소를 넣는다.
GMS_BASE_URL=
# LLM 모델명. 2026-10-23 검증에 쓴 값: gpt-4.1-mini
LLM_MODEL=
# 임베딩 모델명. 2026-10-23 검증에 쓴 값: text-embedding-3-small
EMBEDDING_MODEL=

# ── 권장 ───────────────────────────────────────────────
# 외부 문서 수집 User-Agent에 넣을 영문 연락처(이메일/URL). 없으면 WIKI_CONTACT를 쓴다. (NF2006)
CONTACT=

# ── 선택: LangSmith 추적 ────────────────────────────────
LANGSMITH_TRACING=
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=
